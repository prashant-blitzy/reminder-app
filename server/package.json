{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "seed": "tsx src/scripts/seedReminders.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "4.1.11",
    "supertest": "7.3.1",
    "@types/node": "20.19.43",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/better-sqlite3": "9.6.0"
  }
}
